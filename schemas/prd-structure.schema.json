{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRD-STRUCTURE 分片（docs/prd/$COMPONENT/$MODULE/trace/prd.json）",
  "comment": "对应 templates/PRD-STRUCTURE.json。组件/模块 snake_case（连字符只作层级分隔，charter §2）。priority 为可选字段（M/S/C，需求优先级；与缺陷分级 P0/P1/P2 无关）。",
  "type": "object",
  "required": ["project", "component", "module", "functions"],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "component": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "module": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string" },
    "source": { "type": "string" },
    "source_hash": { "type": "string" },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "acceptance", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^fr-[a-z][a-z0-9_]*-[a-z][a-z0-9_]*-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "biz_refs": { "type": "array", "items": { "type": "string", "pattern": "^biz-[a-z][a-z0-9_]*-[a-z][a-z0-9_]*-[0-9]{3}$" } },
          "actor": { "type": "string" },
          "priority": { "type": "string", "enum": ["M", "S", "C"] },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["key", "given", "when", "then", "kind"],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "given": { "type": "string" },
                "when": { "type": "string" },
                "then": { "type": "string" },
                "kind": { "type": "string", "enum": ["normal", "boundary", "negative"] }
              },
              "additionalProperties": false
            }
          },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["active", "deprecated"] }
        },
        "additionalProperties": false
      }
    }
  }
}
