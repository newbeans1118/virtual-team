{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BUG 缺陷单（test/bugs/BUG-$COMPONENT-NNN.json）",
  "comment": "对应 templates/BUG.json。severity 是唯一分级字段。source 必须回指 exec（度量分母依据，charter §7）。",
  "type": "object",
  "required": ["id", "title", "severity", "source", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^BUG-[a-z][a-z0-9_]*-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
    "source": {
      "type": "object",
      "required": ["exec", "run", "case"],
      "properties": {
        "exec": { "type": "string", "pattern": "^P-[0-9]{3}-[0-9]+$" },
        "run": { "type": "string", "pattern": "^RUN-[0-9]{3}$" },
        "case": { "type": "string", "pattern": "^CASE-[a-z][a-z0-9_]*-[0-9]{3}$" },
        "td": { "type": "string", "pattern": "^TD-[a-z][a-z0-9_]*-[0-9]{3}$" }
      },
      "additionalProperties": false
    },
    "function_refs": { "type": "array", "items": { "type": "string", "pattern": "^fr-[a-z][a-z0-9_]*-[a-z][a-z0-9_]*-[0-9]{3}$" } },
    "acceptance_refs": { "type": "array", "items": { "type": "string", "pattern": "^fr-[a-z][a-z0-9_]*-[a-z][a-z0-9_]*-[0-9]{3}:[a-z0-9_]+$" } },
    "repro_steps": { "type": "array", "items": { "type": "string" } },
    "expected": { "type": "string" },
    "actual": { "type": "string" },
    "evidence": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "in_fix", "fixed", "verify_pass", "verify_fail", "closed", "rejected", "deferred"] },
    "assigned_to": { "type": "string" },
    "fix": {
      "type": "object",
      "properties": {
        "commit": { "type": "string" },
        "by": { "type": "string" },
        "at": { "type": "string" },
        "review": {
          "type": "object",
          "properties": {
            "result": { "type": "string", "enum": ["pending", "pass", "fail"] },
            "reviewer": { "type": "string" },
            "report_ref": { "type": "string" },
            "at": { "type": "string" }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "run": { "type": "string", "pattern": "^RUN-[0-9]{3}$" },
        "execs": { "type": "array", "items": { "type": "string", "pattern": "^P-[0-9]{3}-[0-9]+$" } },
        "result": { "type": "string", "enum": ["pass", "fail"] }
      }
    },
    "reopen_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
