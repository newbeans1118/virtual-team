{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "STORE-CONFIG（JSON 单轨配置）",
  "comment": "对应 templates/STORE-CONFIG.json；存放 test/STORE-CONFIG.json。缺失 = FAIL（fail-closed）。store 固定 json，不提供选轨。",
  "type": "object",
  "required": ["project", "store", "created_at"],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "store": { "type": "string", "enum": ["json"] },
    "created_at": { "type": "string", "minLength": 1 },
    "confirmed_by": { "type": "string" }
  }
}
